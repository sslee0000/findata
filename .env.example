# findata 환경변수 — 각 소비 repo의 .env 로 복사해서 채우세요.
# 키는 findata 저장소가 아니라 "사용하는 repo" 쪽에 둡니다(비밀은 코드에 안 들어감).

# 한국은행 ECOS Open API 인증키 (환율 역대 조회 시)
# 발급: https://ecos.bok.or.kr/api/  (가입 즉시 발급, ~1일 내 활성화)
ECOS_API_KEY=

# 공공데이터포털 인증키 (서울 실거래가)
# ★ "국토교통부_아파트 매매 실거래가 상세 자료" 활용신청 (endpoint: getRTMSDataSvcAptTradeDev)
#    https://www.data.go.kr/data/15126468/openapi.do  (~1~2시간 내 활성화)
#    → 라이브러리가 상세(Dev) 엔드포인트를 호출하므로 반드시 '상세 자료'를 신청.
# 발급 후 '일반 인증키(Decoding)' 값을 넣으세요.
DATA_GO_KR_KEY=

# 로컬 캐시 디렉터리 (미설정 시 ~/.cache/findata)
# FINDATA_CACHE_DIR=
